# Server
PORT=4000
NODE_ENV=development

# Supabase PostgreSQL Connection String (Use Transaction/Session Pooler URL for Vercel)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Supabase Storage (Server-side Service Role Key - NEVER expose to frontend)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=pharmacare-uploads

# JWT Authentication
JWT_SECRET=replace-with-a-long-random-64-char-secret
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (comma-separated)
CORS_ORIGIN=https://pharmacare-ab4b6.web.app,http://localhost:5000,http://127.0.0.1:5000

# Optional: Resend API Key for Reset Password emails
RESEND_API_KEY=
EMAIL_FROM=PharmaCare <noreply@yourdomain.com>
